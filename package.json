{
  "name": "tarot",
  "private": true,
  "version": "0.1.0",
  "description": "Multiplayer browser card game: place 4-edged colour cards domino-style, most exposed edges of your colour wins.",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "dev:server": "pnpm --filter @tarot/server dev",
    "dev:client": "pnpm --filter @tarot/client dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "start": "pnpm --filter @tarot/server start"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
